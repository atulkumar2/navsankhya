---
import { getEntry, render } from 'astro:content';
import Base from '../layouts/Base.astro';
import github from '../content/github-projects.json';
import { formatDate } from '../lib/content';
const summary = await getEntry('pages', 'github');
if (!summary) throw new Error('GitHub summary content is missing');
const { Content } = await render(summary);
---
<Base title="GitHub projects" description={summary.data.description}>
  <section class="wrap page-intro github-intro">
    <p class="eyebrow">CODE / EXPERIMENTS / LEARNING</p>
    <h1>{summary.data.title}</h1>
    <p>A closer look at the projects and ideas behind <a href={github.profileUrl}>@atulkumar2 ↗</a>.</p>
    <div class="github-intro-actions"><a class="button" href={github.profileUrl}>View GitHub profile <span aria-hidden="true">↗</span></a><span>Reviewed <time datetime={github.reviewedAt}>{formatDate(github.reviewedAt)}</time></span></div>
  </section>
  <section class="wrap section-block github-overview"><div class="prose"><Content /></div></section>
  <section class="wrap section-block github-projects">
    <div class="section-heading"><div><p class="eyebrow">A SELECTION FROM MY REPOSITORIES</p><h2>Projects to explore</h2></div><span class="section-note">{github.projects.length} selected repositories</span></div>
    <div class="github-grid">{github.projects.map(project => <article class="github-card">
      <div class="github-card-top"><p class="eyebrow">{project.category}</p>{project.archived && <span class="archive-badge">Archived</span>}</div>
      <h3><a href={project.url}>{project.name} <span aria-hidden="true">↗</span></a></h3>
      <p class="repo-name">atulkumar2/{project.repository}</p>
      <p>{project.description}</p>
      <div class="tags">{project.tags.map(tag => <span>{tag}</span>)}</div>
      <p class="github-project-note">{project.note}</p>
      <div class="github-card-links"><a href={project.url}>Repository ↗</a><a href={project.sourceUrl}>README ↗</a>{'liveUrl' in project && <a href={project.liveUrl}>Live site ↗</a>}</div>
    </article>)}</div>
    <p class="github-review-note">This is a curated snapshot of public repository metadata and documentation, reviewed on {formatDate(github.reviewedAt)}. The summaries describe documented scope; the projects have not been executed or independently audited for this page. Visit GitHub for current code and status.</p>
  </section>
</Base>
