---
import type { CollectionEntry } from 'astro:content';
import { articlePath } from '../lib/publication.mjs';
import { formatDate } from '../lib/content';
interface Props { articles: CollectionEntry<'articles'>[]; }
const { articles } = Astro.props;
---
<div class="article-list">
  {articles.map(article => <article class="article-row">
    <div class="article-meta"><span>{article.id.startsWith('it/') ? 'IT' : 'Non-IT'} {article.data.type === 'experiment' && '· Experiment'}</span><time datetime={article.data.publishedAt}>{formatDate(article.data.publishedAt)}</time></div>
    <h3><a href={articlePath(article.id)}>{article.data.title}<span aria-hidden="true"> ↗</span></a></h3>
    <p>{article.data.description}</p>
    <div class="tags">{article.data.tags.map(tag => <span>{tag}</span>)}</div>
  </article>)}
</div>
